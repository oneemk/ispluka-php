# Application
APP_NAME=ISPLUKA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Dhaka

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=change_me
DB_USERNAME=change_me
DB_PASSWORD=change_me

# Session
SESSION_DRIVER=file
SESSION_NAME=ispluka_session
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Security
APP_KEY=change_me
CSRF_ENABLED=true

# Logging
LOG_LEVEL=warning
LOG_CHANNEL=file

# Mail
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=mail_username
MAIL_PASSWORD=mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ISPLUKA

# bKash
BKASH_BASE_URL=https://example.invalid
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# Nagad
NAGAD_BASE_URL=https://example.invalid
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_private_key
NAGAD_PG_PUBLIC_KEY=your_nagad_pg_public_key

# SSLCommerz / Card
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# MikroTik
MIKROTIK_TIMEOUT=10
MIKROTIK_VERIFY_SSL=true

# IMPORTANT:
# Copy this file to .env for local/production configuration.
# Never commit .env or real credentials to Git.
